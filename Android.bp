//
// AFME (Adreno Frame Motion Engine) — GPU frame generation, shipped as two
// platform graphics layers plus the API-agnostic core they share.

cc_defaults {
    name: "afme_defaults",
    system_ext_specific: true,

    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-fvisibility=hidden",
        "-DLOG_TAG=\"AFME\"",
    ],
}

// Scheduling, configuration, statistics and the engagement gate — everything
// about frame generation that is not graphics.
//
// This deliberately has NO EGL/GLES/Vulkan dependency. libAFME_layer resolves
// GL through eglGetProcAddress and does not link libGLESv3, so shared code that
// touched GL directly would be an undefined symbol there under
// -Wl,--no-undefined. Keeping the core graphics-free is what lets one copy of
// the control law serve both layers.
cc_library_static {
    name: "libAFME_core",
    defaults: ["afme_defaults"],

    srcs: ["afme_core.cpp"],

    shared_libs: [
        "liblog",
        "libcutils",
    ],

    export_include_dirs: ["."],
}

// AFME (Adreno Frame Motion Engine) EGL Layer
// Intercepts eglSwapBuffers to inject GPU-accelerated frame extrapolation
// using Qualcomm's GL_QCOM_frame_extrapolation and GL_QCOM_motion_estimation.
//
// All GL functions are resolved dynamically via eglGetProcAddress —
// the layer only links against libEGL for EGL calls and eglGetProcAddress.
cc_library_shared {
    name: "libAFME_layer",
    defaults: ["afme_defaults"],

    srcs: ["afme_layer.cpp"],

    static_libs: ["libAFME_core"],

    shared_libs: [
        "libEGL",
        "liblog",
        "libcutils",
    ],

    header_libs: [
        "gl_headers",
    ],

    cflags: [
        "-DEGL_EGLEXT_PROTOTYPES",
    ],

    ldflags: ["-Wl,--no-undefined"],

    // Discovered by egl_layers.cpp's kAfmeLayerLibraryDir, which is searched when
    // persist.sys.afme.enable is set. Must live outside the app's own directories so
    // the EGL loader opens it in the platform linker namespace — it needs libcutils,
    // which app namespaces do not expose.
    relative_install_path: "afme",
}

// AFME Vulkan Layer — intercepts vkQueuePresentKHR for frame generation
// RE'd interface from libVkLayer_ADRENO_qprofiler.so + AOSP loader source
// File MUST start with "libVkLayer" (DiscoverLayersInPathList filters on that)
// Layer name: VK_LAYER_AFME_frame_gen (named via setDebugLayers)
cc_library_shared {
    name: "libVkLayer_AFME",
    defaults: ["afme_defaults"],

    srcs: ["afme_vk_layer.cpp"],

    static_libs: ["libAFME_core"],

    shared_libs: [
        "liblog",
        "libcutils",
        "libEGL",              // Hidden EGL context for AFME HW interop
        "libGLESv3",           // GLES 3.0 functions (glFinish, glGenTextures, etc.)
        "libnativewindow",     // AHardwareBuffer
    ],

    header_libs: [
        "vulkan_headers",
        "gl_headers",          // GLES type definitions
    ],

    cflags: [
        "-Wno-unused-function",
        "-DVK_USE_PLATFORM_ANDROID_KHR",
    ],

    ldflags: ["-Wl,--no-undefined"],

    // Discovered by layers_extensions.cpp's kAfmeLayerLibraryDir, which is searched
    // when persist.sys.afme.enable is set. Must live outside the app's own directories
    // so the Vulkan loader opens it in the platform linker namespace — it needs
    // libcutils and libc++, which app namespaces do not expose.
    relative_install_path: "afme",
}
